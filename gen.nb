 RowBox[{
  RowBox[{
   RowBox[{"opi", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ret", ",", "g", ",", "x", ",", "y", ",", "n"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"g", " ", "=", 
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"List", "@@", "expr"}], ",", 
         RowBox[{"Power", "[", 
