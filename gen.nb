       "\[IndentingNewLine]", 
      RowBox[{"g", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"e", "/.", 
          RowBox[{"Power", "->", "Table"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"e", ",", "g"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"g", "=", 
       RowBox[{"Flatten", "[", "g", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"g", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"g", ",", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"List", "@@", "expr"}], ",", 
           RowBox[{"Propagator", "[", 
            RowBox[{"x_", ",", "y_"}], "]"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"g", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"e", "/.", 
          RowBox[{
           RowBox[{"Propagator", "[", 
            RowBox[{"x_", ",", "y_"}], "]"}], "->", 
           RowBox[{"x", "<->", "y"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"e", ",", "g"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ret", "=", "True"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"edges", "=", 
          RowBox[{"Delete", "[", 
           RowBox[{"g", ",", "i"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"graph", "=", 
          RowBox[{"Graph", "[", "edges", "]"}]}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"ConnectedGraphQ", "[", "graph", "]"}]}], ",", 
           RowBox[{"ret", "=", "False"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
