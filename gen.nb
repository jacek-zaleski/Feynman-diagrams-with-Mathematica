             "]"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"newFactor", "=", 
         RowBox[{"Total", "[", 
          RowBox[{"factor", "/@", 
           RowBox[{"exps", "[", 
