        "\[IndentingNewLine]", 
        RowBox[{"exps", "=", 
         RowBox[{"Delete", "[", 
          RowBox[{"exps", ",", 
           RowBox[{"List", "/@", "copies"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
