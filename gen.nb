       RowBox[{"{", 
        RowBox[{
         RowBox[{"Propagator", "[", 
          RowBox[{"x_", ",", "y_"}], "]"}], "->", "1"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
