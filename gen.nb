Cell[BoxData[{
 RowBox[{
  RowBox[{"permEquiv", "[", 
   RowBox[{"expr1_", ",", "expr2_", ",", "symbols_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ret", ",", "perm", ",", "rule", ",", "rules"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"rule", "[", "perm_", "]"}], ":=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"symbols", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "->", 
         RowBox[{"perm", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "symbols", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rules", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"rule", "[", "perm", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"perm", ",", 
          RowBox[{"Permutations", "[", "symbols", "]"}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"permuted1s", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"expr1", "/.", "rule"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"rule", ",", "rules"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ret", "=", "False"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{"permuted1", "-", "expr2"}], "]"}], "==", "0"}], ",", 
         RowBox[{"ret", "=", "True"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"permuted1", ",", "permuted1s"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "ret"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sumPermutations", "[", 
   RowBox[{"exps0_", ",", "symbols_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "exps", ",", "newExps", ",", "copies", ",", "newExp", ",", "i", ",", 
      "factor", ",", "newFactor"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"exps", "=", "exps0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"newExps", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"i", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"factor", "[", "expr_", "]"}], ":=", 
      RowBox[{"expr", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Propagator", "[", 
          RowBox[{"x_", ",", "y_"}], "]"}], "->", "1"}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "exps", "]"}], ">", "0"}], "&&", 
        RowBox[{"i", "<", "20"}]}], ",", 
       RowBox[{
        RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"copies", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "exps", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"permEquiv", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"exps", "[", 
                RowBox[{"[", "#", "]"}], "]"}], "/", 
               RowBox[{"factor", "[", 
                RowBox[{"exps", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{"exps", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "/", 
               RowBox[{"factor", "[", 
                RowBox[{"exps", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", "symbols"}], 
             "]"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"newFactor", "=", 
         RowBox[{"Total", "[", 
          RowBox[{"factor", "/@", 
           RowBox[{"exps", "[", 
            RowBox[{"[", "copies", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"newExp", "=", 
         RowBox[{"newFactor", " ", 
          RowBox[{
           RowBox[{"exps", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "/", 
           RowBox[{"factor", "[", 
            RowBox[{"exps", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"exps", "=", 
         RowBox[{"Delete", "[", 
          RowBox[{"exps", ",", 
           RowBox[{"List", "/@", "copies"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"newExps", ",", "newExp"}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "newExps"}]}],
